# Exclude development, test, and documentation folders
prune .github
prune docs
prune tests

# Exclude root level configuration and build files
exclude uv.lock
exclude Makefile
exclude conftest.py
exclude .gitignore
exclude tox.ini
exclude manage.py
exclude docker-compose.yml
exclude catalog-info.yaml
exclude codecov.yml

# Exclude linter configs
exclude .pep8
exclude pycodestyle
exclude pylintrc
exclude pylintrc_tweaks

# Exclude test/coverage artifacts
prune htmlcov
global-exclude .coverage
global-exclude coverage.xml
